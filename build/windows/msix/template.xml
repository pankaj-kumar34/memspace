<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="memspace"
        Arguments=""
        InstallLocation="C:\Program Files\Memspace\Memspace">
    </Installer>
    <PackageInformation
        PackageName="Memspace"
        PackageDisplayName="Memspace"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="Native Desktop Client for Redis, Valkey &amp; In-Memory Databases">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.memspace"
                Description="Native Desktop Client for Redis, Valkey &amp; In-Memory Databases"
                DisplayName="Memspace"
                ExecutableName="memspace"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Memspace</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Native Desktop Client for Redis, Valkey &amp; In-Memory Databases</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="memspace.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
